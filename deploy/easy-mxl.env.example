# EASY MXL environment - template for /etc/default/easy-mxl
#
# Format: KEY=value, one per line, no "export", no quotes needed. The file is
# read by systemd (EnvironmentFile= in deploy/easy-mxl.service) and can also
# be passed to Docker with `docker run --env-file`.
#
# Every variable is optional; the commented value is the built-in default.
# Command-line flags (see `node dist/bin/easy-mxl.js --help`) override these.
#
# The installer (scripts/install-ubuntu24.sh) copies this file to
# /etc/default/easy-mxl and fills in a random EASY_MXL_TOKEN. Keep the file
# readable by root only (chmod 600) once it contains a token.

# Interface to bind. 127.0.0.1 = this machine only. The systemd unit sets
# 0.0.0.0 (all interfaces); when you do that, ALWAYS set EASY_MXL_TOKEN: the
# API controls Docker and is therefore root-equivalent on this host.
#EASY_MXL_HOST=127.0.0.1

# HTTP/WebSocket port of the EASY MXL UI and API.
#EASY_MXL_PORT=9700

# Directory (on a tmpfs) that holds the MXL domains: one sub-directory per
# domain, e.g. /dev/shm/mxl/domain_1. Use /Volumes/mxl to share domains with
# the mxl-hands-on compose files (see the --tmpfs-volumes installer flag).
#EASY_MXL_DOMAIN_ROOT=/dev/shm/mxl

# Docker daemon endpoint. Unset = the default socket /var/run/docker.sock.
# Also accepts tcp://host:2375 (and npipe:// on Windows).
#DOCKER_HOST=unix:///var/run/docker.sock

# Shared secret required on every /api/* request and /ws/* upgrade, sent as
# "Authorization: Bearer <token>", "X-Easy-MXL-Token: <token>" or "?token=".
# Generate one with: openssl rand -hex 16
#EASY_MXL_TOKEN=

# Extra app catalog file(s), colon-separated. They are loaded after the
# built-in catalog/default.json; an entry with the same "id" replaces the
# built-in one, and "disabled": true hides it. See README.md, "App catalog".
#EASY_MXL_CATALOG=/etc/easy-mxl/catalog.json

# Owner and mode applied to newly created domain directories (chown needs
# root). 1000:1000 matches the user the hands-on mxl-writer/mxl-reader images
# run as; the GStreamer web apps run as root and do not care.
#EASY_MXL_DOMAIN_UID=1000
#EASY_MXL_DOMAIN_GID=1000
#EASY_MXL_DOMAIN_MODE=0775

# Log verbosity: debug, info, warn, error (or silent). Logs go to stderr,
# i.e. to the journal under systemd (journalctl -u easy-mxl -f).
#EASY_MXL_LOG_LEVEL=info
